{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "task_id",
    "project",
    "objective",
    "repository",
    "environment",
    "risk_level",
    "owner",
    "acceptance_criteria"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^ORB-[0-9]{4,}$"
    },
    "project": {
      "type": "string"
    },
    "objective": {
      "type": "string",
      "minLength": 10
    },
    "repository": {
      "type": "string"
    },
    "environment": {
      "enum": [
        "local",
        "development",
        "staging",
        "production"
      ]
    },
    "risk_level": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "owner": {
      "type": "string"
    },
    "reviewers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "permissions": {
      "type": "object",
      "properties": {
        "read": {
          "type": "boolean"
        },
        "write": {
          "type": "boolean"
        },
        "deploy": {
          "type": "boolean"
        },
        "destructive": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
